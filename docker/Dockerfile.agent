# syntax=docker/dockerfile:1
# ConfigFlow Agent Dockerfile (统一镜像)
# 包含 Agent + Mihomo + MosDNS + OxiDNS，通过环境变量控制启用的服务；s6-overlay 是 PID 1
#
# 使用方式:
#   Mihomo 模式: SERVICE_TYPE=mihomo
#   MosDNS 模式: SERVICE_TYPE=mosdns
#   AIO 模式:    ENABLE_MIHOMO=true ENABLE_MOSDNS=true

# ==============================================================================
# Stage: 构建 Go Agent（在构建机原生平台交叉编译，不经 QEMU 模拟）
# ==============================================================================
# Go 1.26.11: GO-2026-6859 (net/http server crash); 1.26.10: crypto/x509 distrust of compromised intermediate CA keys (CVE-2026-111943).
FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine AS builder

WORKDIR /build
ENV GOPROXY=https://goproxy.cn,direct

# 先复制依赖文件，利用 Docker 层缓存
COPY backend/agents/go-agent/go.mod backend/agents/go-agent/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# 再复制源码并编译（编译缓存跨构建复用）
COPY backend/agents/go-agent/ ./
ARG TARGETOS TARGETARCH TARGETVARIANT
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} \
    go build -trimpath -ldflags="-s -w" -o /configflow-agent .

# ==============================================================================
# Stage: s6-overlay（进程管理，PID 1）。固定版本并校验 SHA256；在构建机原生平台下载解包
# ==============================================================================
FROM --platform=$BUILDPLATFORM alpine:latest AS s6-overlay
ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.3.2
RUN set -eu; \
    case "$TARGETARCH" in \
        amd64) arch=x86_64; sum=e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408 ;; \
        arm64) arch=aarch64; sum=b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c ;; \
        *) echo "s6-overlay: unsupported architecture $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}"; \
    cd /tmp; \
    wget -q "$base/s6-overlay-noarch.tar.xz" "$base/s6-overlay-${arch}.tar.xz"; \
    printf '%s  %s\n' 5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12 s6-overlay-noarch.tar.xz \
        "$sum" "s6-overlay-${arch}.tar.xz" | sha256sum -c -; \
    mkdir /out; \
    tar -C /out -Jxpf s6-overlay-noarch.tar.xz; \
    tar -C /out -Jxpf "s6-overlay-${arch}.tar.xz"

# ==============================================================================
# Stage: 服务二进制来源
# ==============================================================================
FROM metacubex/mihomo:latest AS mihomo-bin
FROM irinesistiana/mosdns:latest AS mosdns-bin
FROM svenshi/oxidns:v1.6.1@sha256:78e322898a99900ed63e5aa0c6fe406210597ca5f2380ff2fd5ec8bec3a04381 AS oxidns-bin

# 汇总所有二进制与配置，在最终镜像中只占一层
FROM scratch AS rootfs
COPY --chmod=755 --from=builder /configflow-agent /usr/local/bin/configflow-agent
COPY --chmod=755 --from=mihomo-bin /mihomo /usr/local/bin/mihomo
COPY --chmod=755 --from=mosdns-bin /usr/bin/mosdns /usr/local/bin/mosdns
COPY --chmod=755 --from=oxidns-bin /usr/local/bin/oxidns /usr/local/bin/oxidns
COPY --from=oxidns-bin /etc/oxidns/webui /usr/share/oxidns/webui
COPY --from=oxidns-bin /usr/share/licenses/oxidns/LICENSE /usr/share/licenses/oxidns/LICENSE
COPY --from=s6-overlay /out/ /
COPY --chmod=755 docker/docker-agent-entrypoint-service.sh /entrypoint.sh
COPY --chmod=755 docker/docker-ha-companion-entrypoint.sh /ha-companion-entrypoint.sh
# 只为旧面板生成的脚本和旧部署过渡，计划在下一个大版本删除（见 behaviour-changes）
COPY --chmod=755 docker/compat/supervisorctl /usr/bin/supervisorctl
COPY --chmod=755 docker/compat/python3 /usr/bin/python3

# ==============================================================================
# Final: 统一镜像（Agent + Mihomo + MosDNS + OxiDNS，s6-overlay 管理进程，不含 Python）
# 系统包层在前、二进制层在后：上游核心或 Agent 更新时不再重装系统包
# ==============================================================================
FROM alpine:latest

# 优先使用国内镜像源加速；镜像源不可用时（DNS 抖动、临时故障）
# 自动回退官方源，避免 CI 因单一镜像源随机失败
RUN { sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories && apk update; } || \
    { echo "镜像源不可用，回退官方源" && \
      sed -i 's/mirrors.tuna.tsinghua.edu.cn/dl-cdn.alpinelinux.org/g' /etc/apk/repositories && apk update; } && \
    apk add --no-cache ca-certificates tzdata su-exec bash keepalived iproute2 && \
    rm -rf /var/cache/apk/* && \
    mkdir -p /etc/mihomo /etc/mosdns /etc/oxidns/state /var/log/configflow /run && \
    chmod -R 755 /etc/mihomo && chmod -R 775 /etc/mosdns

COPY --link --from=rootfs / /

ENV SERVER_URL="" AGENT_IP="" HEARTBEAT_INTERVAL="30" TZ=Asia/Shanghai \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 S6_VERBOSITY=1 S6_KILL_GRACETIME=1000

EXPOSE 8080 8081 8082 53/tcp 53/udp 1053/tcp 1053/udp 7890 7891 7892 9090 9199

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/init"]
